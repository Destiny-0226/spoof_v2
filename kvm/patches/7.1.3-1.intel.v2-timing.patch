+static void kvm_read_hybrid_pmu_sample(void *data)
+{
+	struct kvm_hybrid_pmu_sample *sample = data;
+	u32 ecx;
+
+	if (cpuid_eax(0) < 0x1a)
+		return;
+
+	sample->core_type = cpuid_eax(0x1a) >> 24;
+	if (sample->core_type != INTEL_CPU_TYPE_CORE)
+		return;
+
+	cpuid_count(0x0a, 0, &sample->eax, &sample->ebx, &ecx, &sample->edx);
+	if (boot_cpu_has(X86_FEATURE_PDCM))
