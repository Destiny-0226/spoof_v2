+static bool kvm_get_hybrid_pcore_pmu(struct x86_pmu_capability *cap)
+{
+	struct kvm_hybrid_pmu_sample reference = {};
+	struct kvm_hybrid_pmu_sample sample;
+	cpumask_var_t pcore_mask;
+	bool found = false;
+	int cpu, ret;
+
+	if (!zalloc_cpumask_var(&pcore_mask, GFP_KERNEL))
+		return false;
+
+	cpus_read_lock();
+	for_each_online_cpu(cpu) {
+		memset(&sample, 0, sizeof(sample));
+		ret = smp_call_function_single(cpu, kvm_read_hybrid_pmu_sample,
+					       &sample, true);
+		if (ret) {
+			pr_warn("failed to read PMU capability on CPU %d: %d\n",
+				cpu, ret);
+			goto incompatible;
+		}
+
+		if (sample.core_type != INTEL_CPU_TYPE_CORE)
+			continue;
+
+		cpumask_set_cpu(cpu, pcore_mask);
+		if (!found) {
+			reference = sample;
+			found = true;
+			continue;
+		}
+
+		if (sample.eax != reference.eax ||
+		    sample.ebx != reference.ebx ||
+		    sample.edx != reference.edx ||
+		    sample.perf_capabilities != reference.perf_capabilities) {
+			pr_warn("P-core PMU capability differs on CPU %d\n", cpu);
+			goto incompatible;
+		}
+	}
+
+	if (!found || !(reference.eax & 0xff) ||
+	    !((reference.eax >> 8) & 0xff) ||
+	    !((reference.eax >> 16) & 0xff) ||
+	    ((reference.eax >> 16) & 0xff) > 64 ||
+	    ((reference.eax >> 24) & 0xff) > 32 ||
+	    ((reference.edx >> 5) & 0xff) > 64 ||
+	    ((reference.edx & 0x1f) && !((reference.edx >> 5) & 0xff))) {
+		pr_warn("no uniform, valid Intel P-core PMU capability found\n");
+		goto incompatible;
+	}
+
+	cap->version = reference.eax & 0xff;
+	cap->num_counters_gp = (reference.eax >> 8) & 0xff;
+	cap->bit_width_gp = (reference.eax >> 16) & 0xff;
+	cap->events_mask_len = (reference.eax >> 24) & 0xff;
+	cap->events_mask = reference.ebx;
+	cap->num_counters_fixed = reference.edx & 0x1f;
+	cap->bit_width_fixed = (reference.edx >> 5) & 0xff;
+	cap->pebs_ept = 0;
+	cap->mediated = cap->version >= 4 &&
+			  reference.perf_capabilities & PERF_CAP_FW_WRITES;
+
+	pr_info("mediated hybrid vPMU validated P-core CPUs: %*pbl\n",
+		cpumask_pr_args(pcore_mask));
+	pr_info("P-core PMU capability: v%d, %d GP/%d fixed counters, %d-bit\n",
+		cap->version, cap->num_counters_gp,
+		cap->num_counters_fixed, cap->bit_width_gp);
+	if (!cap->mediated)
+		pr_warn("P-core PMU lacks mediated-vPMU prerequisites; using the perf-backed vPMU\n");
+
+	cpus_read_unlock();
+	free_cpumask_var(pcore_mask);
+	return true;
+
+incompatible:
+	cpus_read_unlock();
+	free_cpumask_var(pcore_mask);
+	memset(cap, 0, sizeof(*cap));
+	return false;
+}
