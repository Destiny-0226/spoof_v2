+static bool vmx_cpuid_fast_cacheable_function(struct kvm_vcpu *vcpu,
+					       u32 function);
+
+static void vmx_cpuid_fast_cache_value(struct kvm_vcpu *vcpu,
+					struct kvm_cpuid_entry2 *entry,
+					u32 *eax, u32 *ebx, u32 *ecx, u32 *edx)
+{
+	*eax = entry->function;
+	*ecx = (entry->flags & KVM_CPUID_FLAG_SIGNIFCANT_INDEX) ?
+		entry->index : 0;
+	kvm_cpuid(vcpu, eax, ebx, ecx, edx, false);
+}
+
+static void vmx_cpuid_fast_cache_query_value(struct kvm_vcpu *vcpu,
+						      u32 function, u32 index,
+						      u32 *eax, u32 *ebx, u32 *ecx,
+						      u32 *edx)
+{
+	*eax = function;
+	*ecx = index;
+	kvm_cpuid(vcpu, eax, ebx, ecx, edx, false);
+}
+
+struct vmx_cpuid_fast_cache_query {
+	u32 function;
+	u32 index;
+	bool indexed;
+};
+
+/* Common architectural probes which may be synthesized by kvm_cpuid(). */
+static const struct vmx_cpuid_fast_cache_query vmx_cpuid_fast_cache_queries[] = {
+	{ 0x0000000b, 0, true },
+	{ 0x0000000b, 1, true },
+	{ 0x0000000b, 0xff, true },
+	{ 0x0000001f, 0, true },
+	{ 0x0000001f, 1, true },
+	{ 0x40000000, 0, false },
+	{ 0x40000100, 0, false },
+	{ 0x80000000, 0, false },
+	{ 0xc0000000, 0, false },
+	{ 0xffffffff, 0, false },
+};
+
+static void vmx_cpuid_fast_cache_synthetic(struct vcpu_vmx *vmx)
+{
+	struct kvm_vcpu *vcpu = &vmx->vcpu;
+	struct vmx_cpuid_fast_cache_entry *slot;
+	const struct vmx_cpuid_fast_cache_query *query;
+	u32 hash, flags, value_eax, value_ebx, value_ecx, value_edx;
+	int i, probe;
+
+	for (i = 0; i < ARRAY_SIZE(vmx_cpuid_fast_cache_queries); i++) {
+		query = &vmx_cpuid_fast_cache_queries[i];
+		flags = VMX_CPUID_FAST_CACHE_VALID;
+		if (query->indexed)
+			flags |= VMX_CPUID_FAST_CACHE_INDEXED;
+		hash = ((query->function * 0x9e3779b1U) ^
+			(query->index * 0x85ebca6bU)) >> 24;
+		for (probe = 0; probe < VMX_CPUID_FAST_CACHE_PROBES; probe++) {
+			slot = &vmx->cpuid_fast_cache[
+				(hash + probe) & (VMX_CPUID_FAST_CACHE_SIZE - 1)];
+			if (!(slot->flags & VMX_CPUID_FAST_CACHE_VALID))
+				break;
+			if (slot->function == query->function &&
+			    slot->index == query->index &&
+			    (slot->flags & VMX_CPUID_FAST_CACHE_INDEXED) ==
+			    (flags & VMX_CPUID_FAST_CACHE_INDEXED))
+				goto next_synthetic_query;
+		}
+		if (probe == VMX_CPUID_FAST_CACHE_PROBES)
+			continue;
+
+		vmx_cpuid_fast_cache_query_value(vcpu, query->function,
+						 query->index, &value_eax, &value_ebx,
+						 &value_ecx, &value_edx);
+		slot->function = query->function;
+		slot->index = query->index;
+		slot->eax = value_eax;
+		slot->ebx = value_ebx;
+		slot->ecx = value_ecx;
+		slot->edx = value_edx;
+		slot->flags = flags;
+next_synthetic_query:
+		continue;
+	}
+}
+
+static void vmx_cpuid_fast_cache_refresh(struct vcpu_vmx *vmx)
+{
+	struct kvm_vcpu *vcpu = &vmx->vcpu;
+	struct kvm_cpuid_entry2 *entry;
+	struct vmx_cpuid_fast_cache_entry *slot;
+	u32 function, index, hash, flags;
+	u32 value_eax, value_ebx, value_ecx, value_edx;
+	int i, probe;
+
+	memset(vmx->cpuid_fast_cache, 0, sizeof(vmx->cpuid_fast_cache));
+	for (i = 0; i < vcpu->arch.cpuid_nent; i++) {
+		entry = &vcpu->arch.cpuid_entries[i];
+		function = entry->function;
+		if (!vmx_cpuid_fast_cacheable_function(vcpu, function))
+			continue;
+		flags = VMX_CPUID_FAST_CACHE_VALID;
+		if (entry->flags & KVM_CPUID_FLAG_SIGNIFCANT_INDEX) {
+			flags |= VMX_CPUID_FAST_CACHE_INDEXED;
+			index = entry->index;
+		} else {
+			index = 0;
+		}
+		hash = ((function * 0x9e3779b1U) ^
+			(index * 0x85ebca6bU)) >> 24;
+		for (probe = 0; probe < VMX_CPUID_FAST_CACHE_PROBES; probe++) {
+			slot = &vmx->cpuid_fast_cache[
+				(hash + probe) & (VMX_CPUID_FAST_CACHE_SIZE - 1)];
+			if (!(slot->flags & VMX_CPUID_FAST_CACHE_VALID))
+				break;
+			if (slot->function == function && slot->index == index &&
+			    (slot->flags & VMX_CPUID_FAST_CACHE_INDEXED) ==
+			    (flags & VMX_CPUID_FAST_CACHE_INDEXED))
+				goto next_dynamic_entry;
+		}
+		if (probe == VMX_CPUID_FAST_CACHE_PROBES)
+			continue;
+		slot->function = function;
+		slot->index = index;
+		vmx_cpuid_fast_cache_value(vcpu, entry, &value_eax, &value_ebx,
+						    &value_ecx, &value_edx);
+		slot->eax = value_eax;
+		slot->ebx = value_ebx;
+		slot->ecx = value_ecx;
+		slot->edx = value_edx;
+		slot->flags = flags;
+next_dynamic_entry:
+		continue;
+	}
+	vmx_cpuid_fast_cache_synthetic(vmx);
+	vmx->cpuid_fast_cache_generation = vcpu->stat.cpuid_dynamic_generation;
+}
+
+static u64 vmx_cpuid_inner_fastpath_blockers(struct vcpu_vmx *vmx,
+					     bool force_immediate_exit)
+{
+	struct kvm_vcpu *vcpu = &vmx->vcpu;
+	struct kvm_pmu *pmu = vcpu_to_pmu(vcpu);
+	u64 blockers = 0;
+
+	if (!IS_ENABLED(CONFIG_X86_64) || !READ_ONCE(fast_cpuid) ||
+	    !READ_ONCE(fast_cpuid_direct) || !READ_ONCE(fast_cpuid_inner))
+		blockers |= VMX_CPUID_INNER_BLOCK_DISABLED;
+	if (force_immediate_exit)
+		blockers |= VMX_CPUID_INNER_BLOCK_IMMEDIATE;
+	if (trace_kvm_entry_enabled() || trace_kvm_exit_enabled() ||
+	    kvm_cpuid_trace_enabled())
+		blockers |= VMX_CPUID_INNER_BLOCK_TRACE;
+
+#ifdef CONFIG_CPU_MITIGATIONS
+	if (static_branch_unlikely(&vmx_l1d_should_flush))
+		blockers |= VMX_CPUID_INNER_BLOCK_L1D;
+#endif
+
+	if (is_guest_mode(vcpu) || is_smm(vcpu))
+		blockers |= VMX_CPUID_INNER_BLOCK_MODE;
+	if (vcpu->guest_debug ||
+	    vcpu->arch.switch_db_regs & KVM_DEBUGREG_WONT_EXIT)
+		blockers |= VMX_CPUID_INNER_BLOCK_DEBUG;
+	if (cpuid_fault_enabled(vcpu))
+		blockers |= VMX_CPUID_INNER_BLOCK_FAULT;
+	if (vcpu->arch.cpuid_dynamic_bits_dirty)
+		blockers |= VMX_CPUID_INNER_BLOCK_DYNAMIC;
+	if (!bitmap_empty(pmu->pmc_counting_instructions, X86_PMC_IDX_MAX))
+		blockers |= VMX_CPUID_INNER_BLOCK_PMU;
+
+#ifdef CONFIG_KVM_XEN
+	if (vcpu->arch.xen.cpuid.base)
+		blockers |= VMX_CPUID_INNER_BLOCK_XEN;
+#endif
+
+	return blockers;
+}
