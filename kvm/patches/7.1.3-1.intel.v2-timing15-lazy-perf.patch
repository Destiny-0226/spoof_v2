+	/* Trap a guest enable before removing the atomic PMU state switch. */
+	vmx_set_intercept_for_msr(vcpu, MSR_CORE_PERF_GLOBAL_CTRL,
+				  MSR_TYPE_W, true);
+	vm_entry_controls_clearbit(vmx, VM_ENTRY_LOAD_IA32_PERF_GLOBAL_CTRL);
+	vm_exit_controls_clearbit(vmx, vmexit_perf);
+	vcpu->stat.cpuid_inner_lazy_perf_windows++;
+	return true;
+}
+
+static void vmx_cpuid_inner_lazy_perf_end(struct vcpu_vmx *vmx)
+{
+	struct kvm_vcpu *vcpu = &vmx->vcpu;
+	u32 vmexit_perf = VM_EXIT_LOAD_IA32_PERF_GLOBAL_CTRL |
+			  VM_EXIT_SAVE_IA32_PERF_GLOBAL_CTRL;
+
+	/* Restore KVM's normal PMU policy before handling the non-CPUID exit. */
+	vm_entry_controls_setbit(vmx, VM_ENTRY_LOAD_IA32_PERF_GLOBAL_CTRL);
+	vm_exit_controls_setbit(vmx, vmexit_perf);
+	vmx_set_intercept_for_msr(vcpu, MSR_CORE_PERF_GLOBAL_CTRL,
+				  MSR_TYPE_W,
+				  kvm_need_perf_global_ctrl_intercept(vcpu));
+	vcpu->stat.cpuid_inner_lazy_perf_restores++;
+}
