+		    sample.ebx != reference.ebx ||
+		    sample.edx != reference.edx ||
+		    sample.perf_capabilities != reference.perf_capabilities) {
+			pr_warn("P-core PMU capability differs on CPU %d\n", cpu);
+			goto incompatible;
+		}
+	}
+
+	if (!found || !(reference.eax & 0xff) ||
+	    !((reference.eax >> 8) & 0xff) ||
+	    !((reference.eax >> 16) & 0xff) ||
+	    ((reference.eax >> 16) & 0xff) > 64 ||
