+static bool vmx_cpuid_inner_lazy_perf_begin(struct vcpu_vmx *vmx,
+					    u64 cpuid_inner_blockers)
+{
+	struct kvm_vcpu *vcpu = &vmx->vcpu;
+	struct kvm_pmu *pmu = vcpu_to_pmu(vcpu);
+	u32 vmexit_perf = VM_EXIT_LOAD_IA32_PERF_GLOBAL_CTRL |
+			  VM_EXIT_SAVE_IA32_PERF_GLOBAL_CTRL;
+
+	if (!READ_ONCE(fast_cpuid_inner_lazy_perf) || cpuid_inner_blockers ||
+	    !kvm_vcpu_has_mediated_pmu(vcpu) ||
+	    !cpu_has_load_perf_global_ctrl() ||
+	    !cpu_has_save_perf_global_ctrl() || pmu->global_ctrl ||
+	    vmcs_read64(GUEST_IA32_PERF_GLOBAL_CTRL) ||
+	    vmcs_read64(HOST_IA32_PERF_GLOBAL_CTRL) ||
+	    !(vm_entry_controls_get(vmx) &
+	      VM_ENTRY_LOAD_IA32_PERF_GLOBAL_CTRL) ||
+	    (vm_exit_controls_get(vmx) & vmexit_perf) != vmexit_perf)
+		return false;
