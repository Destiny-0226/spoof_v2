+static bool vmx_cpuid_inner_can_skip_rfds_verw(void)
+{
+	/*
+	 * RFDS affects the Atom/E-core side of Intel hybrid processors, but its
+	 * architectural enumeration is package-wide.  Restrict this experiment
+	 * to a P-core and reject every other vulnerability which can require the
+	 * same VERW-before-VM-entry sequence.
+	 */
+	if (!READ_ONCE(fast_cpuid_inner_skip_rfds_pcore) ||
+	    !cpu_feature_enabled(X86_FEATURE_CLEAR_CPU_BUF_VM) ||
+	    !boot_cpu_has_bug(X86_BUG_RFDS) ||
+	    boot_cpu_has_bug(X86_BUG_MDS) ||
+	    boot_cpu_has_bug(X86_BUG_TAA) ||
+	    boot_cpu_has_bug(X86_BUG_MMIO_STALE_DATA))
+		return false;
+
+	return cpu_data(raw_smp_processor_id()).topo.intel_type ==
+	       INTEL_CPU_TYPE_CORE;
+}
