+		eax = vmx->cpuid0_cache.eax;
+		ebx = vmx->cpuid0_cache.ebx;
+		edx = vmx->cpuid0_cache.edx;
+		kvm_trace_cpuid(0, ecx, eax, ebx, vmx->cpuid0_cache.ecx, edx,
+				true, false);
+		ecx = vmx->cpuid0_cache.ecx;
+	} else {
+		/* Keep the live KVM model and all runtime leaf fixups. */
+		kvm_cpuid(vcpu, &eax, &ebx, &ecx, &edx, false);
+	}
+	kvm_rax_write(vcpu, eax);
+	kvm_rbx_write(vcpu, ebx);
+	kvm_rcx_write(vcpu, ecx);
+	kvm_rdx_write(vcpu, edx);
