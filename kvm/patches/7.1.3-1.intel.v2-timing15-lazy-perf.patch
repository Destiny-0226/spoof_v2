+static int vmx_emulate_cpuid_fast(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+	u32 eax = kvm_rax_read(vcpu), ecx = kvm_rcx_read(vcpu);
+	u32 ebx, edx;
