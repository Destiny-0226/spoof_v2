+static bool kvm_get_hybrid_pcore_pmu(struct x86_pmu_capability *cap)
+{
+	struct kvm_hybrid_pmu_sample reference = {};
+	struct kvm_hybrid_pmu_sample sample;
+	cpumask_var_t pcore_mask;
+	bool found = false;
+	int cpu, ret;
+
+	if (!zalloc_cpumask_var(&pcore_mask, GFP_KERNEL))
+		return false;
+
+	cpus_read_lock();
+	for_each_online_cpu(cpu) {
+		memset(&sample, 0, sizeof(sample));
+		ret = smp_call_function_single(cpu, kvm_read_hybrid_pmu_sample,
+					       &sample, true);
+		if (ret) {
+			pr_warn("failed to read PMU capability on CPU %d: %d\n",
+				cpu, ret);
+			goto incompatible;
+		}
+
+		if (sample.core_type != INTEL_CPU_TYPE_CORE)
+			continue;
+
+		cpumask_set_cpu(cpu, pcore_mask);
+		if (!found) {
+			reference = sample;
+			found = true;
+			continue;
+		}
+
+		if (sample.eax != reference.eax ||
+		    sample.ebx != reference.ebx ||
+		    sample.edx != reference.edx ||
+		    sample.perf_capabilities != reference.perf_capabilities) {
+			pr_warn("P-core PMU capability differs on CPU %d\n", cpu);
+			goto incompatible;
+		}
+	}
+
+	if (!found || !(reference.eax & 0xff) ||
+	    !((reference.eax >> 8) & 0xff) ||
+	    !((reference.eax >> 16) & 0xff) ||
+	    ((reference.eax >> 16) & 0xff) > 64 ||
+	    ((reference.eax >> 24) & 0xff) > 32 ||
+	    ((reference.edx >> 5) & 0xff) > 64 ||
+	    ((reference.edx & 0x1f) && !((reference.edx >> 5) & 0xff))) {
+		pr_warn("no uniform, valid Intel P-core PMU capability found\n");
+		goto incompatible;
