+static int vmx_emulate_cpuid_fast(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_vmx *vmx = to_vmx(vcpu);
+	u32 eax = kvm_rax_read(vcpu), ecx = kvm_rcx_read(vcpu);
+	u32 ebx, edx;
+
+	/* Leaf 0 is immutable after KVM_SET_CPUID2 and is a common hot leaf. */
+	if (eax == 0 && likely(vmx->cpuid0_cache.valid)) {
+		eax = vmx->cpuid0_cache.eax;
+		ebx = vmx->cpuid0_cache.ebx;
+		edx = vmx->cpuid0_cache.edx;
+		kvm_trace_cpuid(0, ecx, eax, ebx, vmx->cpuid0_cache.ecx, edx,
+				true, false);
+		ecx = vmx->cpuid0_cache.ecx;
+	} else {
+		/* Keep the live KVM model and all runtime leaf fixups. */
+		kvm_cpuid(vcpu, &eax, &ebx, &ecx, &edx, false);
+	}
+	kvm_rax_write(vcpu, eax);
+	kvm_rbx_write(vcpu, ebx);
+	kvm_rcx_write(vcpu, ecx);
+	kvm_rdx_write(vcpu, edx);
+
+	/*
+	 * The caller excludes TF, userspace debugging, SMM, CPUID faulting,
+	 * and nested guests. Avoid dispatching back through x86.c to VMX,
+	 * but retain VMCS instruction length, RIP wrap, interrupt shadow,
+	 * and the normal PMU instruction-retirement notification.
+	 */
+	if (!vmx_skip_emulated_instruction(vcpu))
+		return 0;
+	kvm_pmu_instruction_retired(vcpu);
+	return 1;
+}
