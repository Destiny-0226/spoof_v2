+	/* Keep exceptional exits and instruction accounting on the slow path. */
+	if (vmx_get_exit_reason(vcpu).full != EXIT_REASON_CPUID ||
+	    to_vmx(vcpu)->idt_vectoring_info & VECTORING_INFO_VALID_MASK ||
+	    is_smm(vcpu) || vcpu->guest_debug || cpuid_fault_enabled(vcpu) ||
+	    vcpu->arch.cpuid_dynamic_bits_dirty ||
+	    !kvm_pmu_is_fastpath_emulation_allowed(vcpu))
+		goto slow_path;
+
+	/*
+	 * Guest TF is independent of KVM_GUESTDBG_* controls. Debug registers
+	 * written without exits are synchronized only after the re-entry loop;
+	 * do not synthesize #DB from a stale DR0-DR3/DR7 snapshot here.
+	 */
+	if ((vcpu->arch.switch_db_regs & KVM_DEBUGREG_WONT_EXIT) ||
+	    (kvm_get_rflags(vcpu) & X86_EFLAGS_TF))
+		goto slow_path;
+
+#ifdef CONFIG_KVM_XEN
+	/* Xen clock leaves can access guest memory without an irq-off SRCU lock. */
+	if (vcpu->arch.xen.cpuid.base)
+		goto slow_path;
+#endif
