+	/*
+	 * Guest TF is independent of KVM_GUESTDBG_* controls. Debug registers
+	 * written without exits are synchronized only after the re-entry loop;
+	 * do not synthesize #DB from a stale DR0-DR3/DR7 snapshot here.
+	 */
+	if ((vcpu->arch.switch_db_regs & KVM_DEBUGREG_WONT_EXIT) ||
